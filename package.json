{
  "name": "localoco",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./server/*",
    "#client/*": "./src/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "start": "NODE_ENV=production bun dist/index.js",
    "build": "bun build --minify --sourcemap --target=bun --outdir=dist server/index.ts && vite build",
    "build:docker": "docker build -t localoco .",
    "preview": "vite preview",
    "clean": "git clean -xdf .cache .turbo dist node_modules .tanstack",
    "dev:server": "bun run --hot server/index.ts",
    "dev:vite": "wait-on http://localhost:4001/health && vite",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:vite\"",
    "format:check": "oxfmt --check .",
    "lint:check": "oxlint",
    "type:check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run server/tests/unit src/tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "vitest run server/tests/unit src/tests/unit tests/integration",
    "test:e2e": "playwright test",
    "security:audit": "bun audit --audit-level=high",
    "db:studio": "bun drizzle-kit studio",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/standard-validator": "^0.4.0",
    "@hookform/resolvers": "^5.7.1",
    "@logtape/logtape": "^2.3.0",
    "@logtape/pretty": "^2.3.1",
    "@logtape/sentry": "^2.3.0",
    "@sentry/bun": "^10.70.0",
    "@sentry/hono": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@shadcn/react": "^0.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-table": "^9.1.2",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.5",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "resend": "^6.20.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@scalar/hono-api-reference": "^0.11.14",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.29",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "globals": "^17.10.0",
    "hono-openapi": "^1.3.1",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
